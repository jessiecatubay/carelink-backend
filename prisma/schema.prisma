generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String            @id @default(uuid())
  email            String?           @unique
  password         String?
  createdAt        DateTime          @default(now())
  firstName        String?
  lastName         String?
  role             Role              @default(USER)
  onBoarded        Boolean           @default(false)
  updatedAt        DateTime          @updatedAt

  nonPatientProfile NonPatientProfile?
  patientProfile    PatientProfile?

  patientConnections    PatientNonPatient[] @relation("PatientConnections")
  nonPatientConnections PatientNonPatient[] @relation("NonPatientConnections")
}

model PatientProfile {
  id                String  @id @default(uuid())
  userId            String  @unique
  age               Int?
  gender            String?
  notes             String?
  connectionCode    String? @unique
  emergencyContact  String?
  medicalConditions String?
  currentPatient    Boolean @default(false)

  user              User    @relation(fields: [userId], references: [id])
}

model NonPatientProfile {
  id              String  @id @default(uuid())
  userId          String  @unique
  emergencyContact String?
  relationship    String?
  user            User    @relation(fields: [userId], references: [id])
}

model PatientNonPatient {
  id           String   @id @default(uuid())
  patientId    String
  nonPatientId String
  status      ConnectionStatus @default(DISCONNECTED)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  patient    User @relation("PatientConnections", fields: [patientId], references: [id], onDelete: Cascade)
  nonPatient User @relation("NonPatientConnections", fields: [nonPatientId], references: [id], onDelete: Cascade)

  @@unique([patientId, nonPatientId])
  @@index([patientId])
  @@index([nonPatientId])
}

enum ConnectionStatus {
  CONNECTED
  DISCONNECTED
}

model VitalReadings {
  id            String   @id @default(uuid())
  deviceId      String
  temperature   Float
  heartRate     Int
  recordedAt    DateTime @default(now())
  sensorContact Boolean

  @@index([deviceId, recordedAt])
}

model Commands {
  id         String   @id @default(dbgenerated("gen_random_uuid()"))
  command    Command?
  status     String?   @default("Pending")
  recordedAt DateTime @default(now())
  deviceId   String?
}

enum Role {
  PATIENT
  NON_PATIENT
  USER
}

enum Command {
  ASSISTANCE
  FOOD
  WATER
  EMERGENCY
}